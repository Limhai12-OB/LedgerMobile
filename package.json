{
  "name": "ledgervision",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev --hostname 127.0.0.1",
    "build": "node init && next build",
    "start": "node init && next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src tests *.mjs *.json README.md"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
